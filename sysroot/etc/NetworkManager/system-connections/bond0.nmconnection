[connection]
id=bond0
type=bond
interface-name=bond0
autoconnect=true
autoconnect-priority=200
mdns=2

[bond]
mode=802.3ad
miimon=100
lacp_rate=slow
xmit_hash_policy=layer3+4

[ipv4]
method=auto
route-metric=100
route1=0.0.0.0/0,10.0.50.1,100
route1_options=table=100
routing-rule1=priority 5200 fwmark 0x80000/0xff0000 table 100

[ipv6]
method=auto
addr-gen-mode=eui64
route-metric=100
routing-rule1=priority 5200 fwmark 0x80000/0xff0000 table 100
