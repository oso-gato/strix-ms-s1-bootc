# Interactive setup on the local console. P4-review hardened: on a headless
# box a boot-time strix-setup would (a) grab the setup flock forever, locking
# out the documented SSH path (first-one-wins inverted), and (b) as a oneshot,
# wedge multi-user.target in 'activating'. So:
#   Type=exec        — the start job completes at spawn; the boot never waits.
#   keypress gate    — the flock is only taken once a human presses ENTER at
#                      the console; until then the SSH path is uncontested.
# strix-setup's flock + sentinel still arbitrate if both engage.
[Unit]
Description=strix interactive first-boot setup on tty1 (keypress-gated)
ConditionPathExists=!/var/home/.strix-secrets/.setup-done
ConditionPathExists=/dev/tty1
After=strix-firstboot-setup.service getty.target
Conflicts=getty@tty1.service

[Service]
Type=exec
ExecStart=/bin/sh -c 'printf "\\n  strix first-boot setup — press ENTER to run it on this console\\n  (or ssh core@strix && sudo strix-setup from another machine)\\n\\n"; read -r _ && exec /usr/bin/strix-setup'
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
