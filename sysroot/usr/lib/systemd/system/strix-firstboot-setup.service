# Every-boot orchestrator (R12 path 1 + R5 enforcement). Runs BEFORE
# tailscaled (delta-review blocker): tailscaled's file store writes an
# initial '{}' state file the moment the daemon starts, which would defeat
# the absent-target restore gate AND let the snapshot refresh clobber the
# preserved tailnet identity with logged-out state. Ordering the restore
# first means the daemon's first start reads the restored identity.
# Needs only NetworkManager (nmcli connection reload) — not network-online.
[Unit]
Description=strix firstboot orchestrator (restore-or-publish + sudo-flip enforcement)
RequiresMountsFor=/var/home
After=strix-home-seed.service NetworkManager.service
Before=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/strix-firstboot-setup

[Install]
WantedBy=multi-user.target
