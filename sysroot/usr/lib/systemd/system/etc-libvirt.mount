# strix: persist libvirt CONFIG on the data drive (R7). Domain/network/pool
# XML and daemon confs live in <strix-vm>/etc-libvirt and are bind-mounted
# over /etc/libvirt, so VM definitions survive a preserve reinstall (the
# system drive's /etc is wiped by reinstall; 3-way /etc merge only covers
# bootc UPDATES, not reinstalls).
#
# Requires=strix-libvirt-seed (not Wants): the seed populates the bind source
# transactionally and exits 0 when a payload already exists — binding an
# empty/partial source over /etc/libvirt must never happen (P4 review).
#
# Data-drive-absent behavior is FAIL-CLOSED by design: this mount is nofail
# (boot proceeds, SSH/Cockpit live), but the libvirt daemons carry
# RequiresMountsFor on both mounts and therefore stay DOWN — a virtqemud
# running against image config would write VM images and nvram onto the
# disposable system drive. Deliberate trade-off; see BUILD-SPEC §4.
[Unit]
Description=strix /etc/libvirt (bind from data drive: strix-vm/etc-libvirt)
RequiresMountsFor=/var/lib/libvirt
After=strix-libvirt-seed.service
Requires=strix-libvirt-seed.service

[Mount]
What=/var/lib/libvirt/etc-libvirt
Where=/etc/libvirt
Type=none
Options=bind,nofail

[Install]
WantedBy=local-fs.target
