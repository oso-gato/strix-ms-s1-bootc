#!/bin/bash
# strix-gh-app-token — mint a short-lived GitHub App installation token (R8/A19)
# that gives the claudebox its GitHub authority. Reads the per-box App
# credentials strix-setup persisted to the data drive, builds an RS256 JWT with
# the base `openssl` (no new packages), exchanges it for a ~1 h installation
# token, and publishes that token to a core-readable tmpfs file the claudebox
# bridges in as GH_TOKEN.
#
# App identity is PER-BOX (never shared, never a personal PAT — A19). The token
# is short-lived and lives only on tmpfs (/run), never on disk. This no-ops
# cleanly when the App is not configured (the firstboot.yaml github_app block
# is optional), so a box without GitHub authority simply has no GH_TOKEN.
# Idempotent; driven by strix-gh-app-token.timer (OnBootSec + ~50 min).
set -euo pipefail
export LC_ALL=C

APP_DIR=/var/home/.strix-secrets/github-app
KEY="$APP_DIR/private-key.pem"
APP_ID_FILE="$APP_DIR/app-id"
INST_ID_FILE="$APP_DIR/installation-id"
OUT_DIR=/run/strix
OUT="$OUT_DIR/gh-token"
API=https://api.github.com

# Optional capability: not configured → nothing to do.
[ -f "$KEY" ] && [ -f "$APP_ID_FILE" ] && [ -f "$INST_ID_FILE" ] || exit 0

APP_ID=$(cat "$APP_ID_FILE"); INST_ID=$(cat "$INST_ID_FILE")

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
# iat backdated 60 s for clock skew; exp +9 min (GitHub caps the JWT at 10).
header='{"alg":"RS256","typ":"JWT"}'
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now-60))" "$((now+540))" "$APP_ID")
h=$(printf '%s' "$header"  | b64url)
p=$(printf '%s' "$payload" | b64url)
sig=$(printf '%s' "$h.$p" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)
jwt="$h.$p.$sig"

# Exchange the App JWT for an installation access token (~1 h).
resp=$(curl -fsSL --retry 2 -X POST \
  -H "Authorization: Bearer $jwt" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "$API/app/installations/$INST_ID/access_tokens") || {
    logger -t strix-gh-app-token -p err "installation-token request failed (App id $APP_ID / inst $INST_ID)"; exit 1; }

token=$(printf '%s' "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("token",""))')
[ -n "$token" ] || { logger -t strix-gh-app-token -p err "no token in installation-token response"; exit 1; }

# Publish to a core-readable tmpfs file (0640 root:core) via atomic rename.
install -d -m 0755 "$OUT_DIR"
umask 077
printf '%s\n' "$token" > "$OUT.tmp"
chown root:core "$OUT.tmp"
chmod 0640 "$OUT.tmp"
mv -f "$OUT.tmp" "$OUT"
logger -t strix-gh-app-token -p info "minted GitHub App installation token (core-readable, ~1 h)"
