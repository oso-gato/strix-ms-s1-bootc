#!/bin/bash
# strix-firstboot-setup — every-boot orchestrator (R12 path 1 + R5 enforcement).
# Four jobs, all idempotent:
#   1. Post-setup enforcement: once the setup sentinel exists, the bootstrap
#      NOPASSWD sudoers file must never survive a boot (a reinstall or image
#      update can resurrect it in /etc), and the setup MOTD comes down.
#   2. PRESERVE RESTORE — runs ONCE PER INSTALL, not once per boot: gated on
#      /var/lib/strix/restore-done, which lives on the SYSTEM drive (wiped by
#      a reinstall, survives reboots). Inside, each credential restores only
#      into an ABSENT/LOCKED target, so a restore can never roll back live
#      state (the P4-review bug class: overwriting rotated Tailscale node
#      keys with a day-of-setup snapshot on every boot).
#   3. SNAPSHOT REFRESH — steady state (setup done, restore done): re-persist
#      the CURRENT password hash, Wi-Fi keyfiles, and tailscaled.state to the
#      data drive, so what a future preserve reinstall restores tracks
#      reality (passwd changes, strix-wifi set-primary, Tailscale key
#      rotation) instead of the day-of-setup snapshot.
#   4. Fresh box: publish the "run strix-setup" MOTD.
# Driven by strix-firstboot-setup.service; not meant to be run by hand.
set -euo pipefail
export LC_ALL=C

SECRETS=/var/home/.strix-secrets
SETUP_DONE="$SECRETS/.setup-done"
RESTORE_DONE=/var/lib/strix/restore-done
NM_DIR=/etc/NetworkManager/system-connections
TS_STATE=/var/lib/tailscale/tailscaled.state
MOTD=/etc/motd.d/10-strix-setup
BOOTSTRAP_SUDOERS=/etc/sudoers.d/strix-bootstrap

install -d -m 0755 /var/lib/strix
# One-time cleanup of the retired per-boot marker (pre-review design).
rm -f "$SECRETS/.setup-done-applied" 2>/dev/null || true

# Shadow-field lock classifier (delta review): locked/absent = empty or
# '!'/'*'-prefixed ('!!' kickstart lock, '!<hash>' passwd -l, '*'). Used by
# BOTH the restore gate (only restore into a locked/empty field) and the
# snapshot guard (never persist a locked/empty field — a preserved '!$y$...'
# would restore an un-sudo-able box after the flip already removed NOPASSWD).
hash_locked_or_empty() {
  case "$1" in ""|"!"*|"*"*) return 0 ;; *) return 1 ;; esac
}
# Tailscale identity heuristic (belt-and-braces behind the Before=tailscaled
# ordering): a bootstrap '{}' or logged-out state carries no profiles.
ts_has_identity() {
  [ -s "$TS_STATE" ] && grep -q '_profiles' "$TS_STATE"
}

# ── (1) Setup finished: tear down the prompt surface, ENFORCE the sudo flip ──
if [ -f "$SETUP_DONE" ]; then
  rm -f "$MOTD"
  if [ -f "$BOOTSTRAP_SUDOERS" ]; then
    rm -f "$BOOTSTRAP_SUDOERS"
    logger -t strix-firstboot-setup -p notice "sudo flip re-enforced (bootstrap NOPASSWD removed)"
  fi
fi

# ── (2) PRESERVE RESTORE — once per install, absent-targets only ─────────────
if [ -d "$SECRETS" ] && [ -f "$SETUP_DONE" ] && [ ! -f "$RESTORE_DONE" ]; then
  # Password hash: only into a locked/empty field (kickstart creates core
  # with --lock on every reinstall; a set password is live state — keep it).
  if [ -f "$SECRETS/core.hash" ]; then
    cur=$(getent shadow core | cut -d: -f2)
    if hash_locked_or_empty "$cur" && ! hash_locked_or_empty "$(cat "$SECRETS/core.hash")"; then
      usermod -p "$(cat "$SECRETS/core.hash")" core
      logger -t strix-firstboot-setup -p notice "restored core password hash"
    fi
  fi

  # Wi-Fi keyfiles: only the ones that don't already exist in /etc.
  reloaded=0
  for kf in "$SECRETS"/wifi-*.nmconnection; do
    [ -e "$kf" ] || continue
    dst="$NM_DIR/$(basename "$kf")"
    if [ ! -e "$dst" ]; then
      install -m 0600 -o root -g root "$kf" "$dst"
      reloaded=1
    fi
  done
  if [ "$reloaded" = 1 ]; then
    nmcli connection reload
    logger -t strix-firstboot-setup -p notice "restored Wi-Fi keyfiles and reloaded NetworkManager"
  fi

  # Tailscale node identity: this unit runs Before=tailscaled.service, so
  # the daemon's first start reads the restored state — no restart needed
  # (a blocking restart here would deadlock against our own Before= edge).
  # The ts_has_identity guard also treats a daemon-bootstrapped '{}' as
  # absent, so an ordering regression can never block the restore.
  if [ -f "$SECRETS/tailscaled.state" ] && ! ts_has_identity; then
    install -d -m 0700 "$(dirname "$TS_STATE")"
    install -m 0600 -o root -g root "$SECRETS/tailscaled.state" "$TS_STATE"
    logger -t strix-firstboot-setup -p notice "restored tailscaled.state before tailscaled first start (tailnet rejoin)"
  fi

  touch "$RESTORE_DONE"
  logger -t strix-firstboot-setup -p notice "preserve restore complete (once per install)"
fi

# ── (3) SNAPSHOT REFRESH — steady state keeps the persisted copies current ───
if [ -f "$SETUP_DONE" ] && [ -f "$RESTORE_DONE" ]; then
  cur=$(getent shadow core | cut -d: -f2)
  if ! hash_locked_or_empty "$cur"; then
    printf '%s\n' "$cur" > "$SECRETS/core.hash.new"
    chmod 0600 "$SECRETS/core.hash.new"
    mv -f "$SECRETS/core.hash.new" "$SECRETS/core.hash"
  fi
  for slot in primary secondary tertiary; do
    src="$NM_DIR/wifi-$slot.nmconnection"
    [ -f "$src" ] && install -m 0600 -o root -g root "$src" "$SECRETS/wifi-$slot.nmconnection"
  done
  # Never snapshot an identity-less state file (bootstrap '{}' / logged-out)
  # — a skipped restore must not be followed by a clobbering snapshot.
  if ts_has_identity; then
    install -m 0600 -o root -g root "$TS_STATE" "$SECRETS/tailscaled.state"
  fi
  logger -t strix-firstboot-setup -p info "credential snapshot refreshed on the data drive"
fi

# ── (4) FRESH / wipe: publish the MOTD prompt for the SSH path ───────────────
if [ ! -f "$SETUP_DONE" ]; then
  install -d -m 0755 "$(dirname "$MOTD")"
  printf '%s\n' \
    '────────────────────────────────────────────────────────────────────' \
    '  strix — first-boot setup not done yet' \
    '────────────────────────────────────────────────────────────────────' \
    '' \
    '  Set the core password, Wi-Fi, and Tailscale (one authorization,' \
    '  pulled from ak-private — or fully interactive):' \
    '  $ ssh core@strix' \
    '  $ sudo strix-setup' \
    '' \
    '  (or press ENTER on the local console / tty1)' \
    '────────────────────────────────────────────────────────────────────' \
    > "$MOTD"
  chmod 0644 "$MOTD"
fi
exit 0
